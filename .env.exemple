# Copier ce fichier en .env, puis remplir avec VOTRE installation de PostgreSQL.
# pg lit ces variables tout seul : new Pool() sans rien d'autre.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=le-mot-de-passe-choisi-a-l-installation
PGDATABASE=ateliers

# Jeton de TEST pour la demonstration. Jamais de vrai secret dans un depot.
JETON_ADMIN=admin-demo-2026
